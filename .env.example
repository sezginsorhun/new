# Bu dosyayı .env olarak kopyalayıp değerleri doldur:  cp .env.example .env

# --- VERİTABANI (MySQL / MariaDB — Hostinger hPanel → Veritabanları) ---
# Biçim:  mysql://KULLANICI:SIFRE@HOST:3306/VERITABANI
# Hostinger'da site ile aynı sunucudaysan HOST = localhost
DATABASE_URL="mysql://u242826491_alenora:SIFRE@localhost:3306/u242826491_alenora"

# Bağlantı havuzu üst sınırı. Paylaşımlı hostingde eşzamanlı bağlantı
# hakkı sınırlıdır; 5 güvenli bir değer, boş bırakırsan 5 kullanılır.
DB_POOL_MAX="5"

# --- SİTE ---
NEXT_PUBLIC_SITE_URL="https://alanadin.com"
NEXT_PUBLIC_SITE_NAME="Alenora"

# Oturum imzalama anahtarı — EN AZ 32 karakter olmalı.
#   openssl rand -base64 48
# Bu değer değişirse herkesin oturumu kapanır.
AUTH_SECRET=""

# --- GİZLİ YÖNETİM ADRESİ ---
# Panel yalnızca bu adresten açılır:  https://alanadin.com/<ADMIN_PATH>
# /admin adresi dışarıya 404 döner, yani panelin varlığı anlaşılmaz.
# İki satır da AYNI değeri taşımalı (biri sunucu, biri tarayıcı tarafı için).
# Tahmin edilmesi zor bir son ek seç:  openssl rand -hex 4
ADMIN_PATH="yonetim-DEGISTIR"
NEXT_PUBLIC_ADMIN_PATH="yonetim-DEGISTIR"

# --- IYZICO ---
# Sandbox: https://sandbox-api.iyzipay.com   |   Canlı: https://api.iyzipay.com
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --- GÖRSEL DEPOLAMA ---
# db   : görseller veritabanında saklanır (VARSAYILAN — her yerde çalışır,
#        yönetilen hosting paketlerinde dağıtımdan sonra kaybolmaz)
# file : public/uploads klasörüne yazar (yalnızca kendi sunucun/VPS varsa)
STORAGE_DRIVER="db"

# --- DAĞITIM ---
# 1 yaparsan her derlemede veritabanı migration'ları otomatik uygulanır.
# Hostinger gibi panelden deploy edilen ortamlarda açık olması rahat eder.
AUTO_MIGRATE="1"

# --- E-POSTA ---
# Yönetici girişindeki 6 haneli doğrulama kodu da buradan gönderilir.
# Tanımlı değilse kod sunucu konsoluna yazılır (sadece geliştirmede).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Alenora <siparis@alanadin.com>"
ADMIN_NOTIFY_EMAIL="sen@alanadin.com"
