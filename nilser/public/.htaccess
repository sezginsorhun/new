# =====================================================================
#  NİLSER — Hostinger (Apache / LiteSpeed) ayarları
#  Bu dosya public_html kökünde durmalıdır.
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS'e zorla
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://nilseraluminyum.com%{REQUEST_URI} [L,R=301]

  # 2) www → çıplak alan adı (tek kanonik adres)
  RewriteCond %{HTTP_HOST} ^www\.nilseraluminyum\.com$ [NC]
  RewriteRule ^ https://nilseraluminyum.com%{REQUEST_URI} [L,R=301]

  # 3) Klasör adreslerinde sondaki / eksikse ekle (/sineklik → /sineklik/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # 4) /index.html → / (yinelenen içerik olmasın)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [L,R=301]
</IfModule>

# --- Sıkıştırma ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Önbellek ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- Güvenlik başlıkları ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' https://www.google.com https://maps.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # Katalog PDF'i tarayıcının kendi görüntüleyicisinde açılsın (CSP onu engellemesin)
  <FilesMatch "\.pdf$">
    Header always unset Content-Security-Policy
    Header set Content-Disposition "inline; filename=NILSER-urun-katalogu.pdf"
  </FilesMatch>

</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/pdf .pdf

# Gizli / yardımcı dosyalara erişimi kapat
<FilesMatch "(^\.|\.(md|log|ini|sh|mjs|lock)$|^(composer|package)\.json$)">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>
